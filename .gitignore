# ===== 编译产物（自动生成，不需要版本管理）=====
# Maven 编译后生成的 class 文件、打包后的 jar，重新构建就会再生，没必要存
target/
# IDEA 编译输出目录（和 target 类似）
out/
# 某些项目用的 bin 目录
bin/

# ===== IDE 配置文件（每台电脑不同，且含本地绝对路径）=====
# IDEA 的工程配置，里面是你的个人界面/路径设置，别人clone了也没用还可能冲突
.idea/
# IDEA 模块文件，记录本机模块配置
*.iml

# ===== Maven 包装脚本（初学者用不到，且可能含平台差异）=====
.mvn/
mvnw
mvnw.cmd

# ===== 本地密钥/配置（绝不提交）=====
# 如果以后你用 application-local.properties 存密码，这一行保证它不上传
application-local.properties

# ===== 操作系统垃圾文件 =====
.DS_Store
Thumbs.db
